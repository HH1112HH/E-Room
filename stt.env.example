# Env rieng cho MAY WHISPER (dung kem docker-compose.stt.yml, GPU-only).
# Copy: copy stt.env.example stt.env   (Windows)
#       cp stt.env.example stt.env     (macOS/Linux)
# File stt.env KHONG commit (chua port/model tuy may).

# Port host map ra ngoai. Backend ben may kia goi http://<IP-tailscale-may-nay>:8001/v1
STT_PORT=8001

# Model HF (bat buoc dang CTranslate2). Turbo = lua chon hien tai.
WHISPER__MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo

# Quantize cho GPU. float16 la chuan cho RTX 3050.
# Muon NHE HƠN nua (VRAM it): WHISPER__COMPUTE_TYPE=int8_float16
WHISPER__COMPUTE_TYPE=float16

# Giay idle thi unload model khoi VRAM (0 = unload ngay, -1 = giu mai).
# Luu y: unload van giu ~300MB (gioi han cua faster-whisper).
WHISPER__TTL=300

# TTS Kokoro (:8002). Voice mac dinh + cac lua chon:
#   af_heart (nu My, am ap — default) | am_adam (nam My)
#   bf_emma (nu Anh) | bm_george (nam Anh)
# Full list: af_alloy af_aoede af_bella af_jessica af_kore af_nicole af_nova
#   af_river af_sarah af_sky am_echo am_eric am_fenrir am_liam am_michael
#   am_onyx am_puck am_santa bf_alice bf_lily bf_isabella bm_daniel bm_fable bm_lewis
TTS_PORT=8002
TTS_VOICE=af_heart
